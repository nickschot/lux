{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/testing.ts"],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/api",
  "name": "Lumen API reference",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "highlightLanguages": [
    "bash",
    "http",
    "javascript",
    "js",
    "json",
    "typescript"
  ],
  "externalSymbolLinkMappings": {
    "@types/node": {
      "EventEmitter.defaultMaxListeners": "https://nodejs.org/api/events.html#eventsdefaultmaxlisteners",
      "Stream.Writable.end": "https://nodejs.org/api/stream.html#writableendchunk-encoding-callback",
      "Stream.Writable.write": "https://nodejs.org/api/stream.html#writablewritechunk-encoding-callback"
    }
  },
  "intentionallyNotExported": ["RequestUrl", "Route"],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "invalidPath": true,
    "rewrittenLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true
}
