{
  "name": "lumen-framework",
  "version": "3.1.1",
  "description": "Build scalable, Node.js-powered REST APIs with almost no code.",
  "keywords": [
    "mvc",
    "api",
    "lux",
    "lumen",
    "jsonapi",
    "json-api",
    "rest",
    "framework"
  ],
  "bugs": {
    "url": "https://github.com/nickschot/lux/issues"
  },
  "repository": "github:nickschot/lux",
  "license": "MIT",
  "author": "Nick Schot <nickschot@gmail.com>",
  "contributors": [
    {
      "name": "Zachary Golba",
      "url": "https://github.com/zacharygolba"
    }
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "module": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing.d.ts",
      "module": "./dist/testing.mjs",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "lumen": "bin/lumen"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:debugger": "node test/utils/debugger/build.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "shx rm -rf coverage dist docs/api test/test-app/dist",
    "debugger": "node --enable-source-maps test/utils/debugger/dist/debug.js",
    "docs:api": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm run build && pnpm run build:types",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "esbuild": "^0.28.2",
    "fb-watchman": "^2.0.2",
    "inflection": "^3.0.2",
    "knex": "^3.3.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lumen-framework": "link:.",
    "prettier": "^3.9.9",
    "release-plan": "^0.20.1",
    "shx": "^0.4.0",
    "sinon": "22.1.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">= 22.14"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "22.23.3",
        "onFail": "download"
      },
      {
        "name": "node",
        "version": ">=22.14",
        "onFail": "warn"
      }
    ]
  }
}
